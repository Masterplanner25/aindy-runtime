# A.I.N.D.Y. Runtime — Environment Variable Reference
# Copy this file to .env and fill in values for your environment.
# See docs/runtime/DEPLOYMENT_PROFILES.md for profile-specific requirements.
# See README.md for minimum required variables per boot mode.
# DO NOT commit .env to version control.

# ── Group 1: Required for any boot ───────────────────────────────────────────
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/aindy
SECRET_KEY=change-me-generate-with-openssl-rand-hex-32
OPENAI_API_KEY=sk-replace-with-real-key
DEEPSEEK_API_KEY=ds-replace-with-real-key
AINDY_API_KEY=replace-with-internal-service-api-key
PERMISSION_SECRET=change-me-generate-with-openssl-rand-hex-32
ALLOWED_ORIGINS=http://localhost:3000

# ── Group 2: Boot mode control ───────────────────────────────────────────────
# AINDY_BOOT_MODE: runtime-only | full (default: full)
AINDY_BOOT_MODE=runtime-only
# AINDY_DEPLOYMENT_PROFILE: single-instance | distributed-api | distributed-worker | hostile-third-party
# Leave empty to let the runtime derive the profile from EXECUTION_MODE.
AINDY_DEPLOYMENT_PROFILE=
# EXECUTION_MODE: thread | async (default: thread)
EXECUTION_MODE=thread

# ── Group 3: Schema control ───────────────────────────────────────────────────
# AINDY_ENFORCE_SCHEMA: true | false — enforce schema validation on boot (default: true in production)
AINDY_ENFORCE_SCHEMA=true
# AINDY_SCHEMA_RECONCILE: true | false — auto-reconcile schema on boot (default: false)
AINDY_SCHEMA_RECONCILE=false
# AINDY_ALLOW_SQLITE: leave empty for production; set to 1 for local smoke tests only
AINDY_ALLOW_SQLITE=

# ── Group 4: Optional infrastructure ─────────────────────────────────────────
# # MONGO_URL=mongodb://HOST:27017/aindy
# # MONGO_REQUIRED=false
# # REDIS_URL=redis://HOST:6379/0
# # AINDY_SKIP_MONGO_PING=
# # AINDY_CACHE_BACKEND=memory
# # AINDY_EVENT_BUS_ENABLED=

# ── Group 5: Local smoke test only (not for production) ───────────────────────
# # DATABASE_URL=sqlite://
# # AINDY_ALLOW_SQLITE=1
