# A.I.N.D.Y. Runtime — Environment Variable Reference
#
# Copy this file to AINDY/.env and fill in real values.
# The runtime reads AINDY/.env at startup via:
#   Settings(env_file=Path(__file__).parent / ".env")
#
# For Docker Compose deployments, values are typically set in the repo-root
# .env instead; see docs/runtime/DEPLOYMENT_PROFILES.md for the distinction.
#
# DO NOT commit .env to version control.
#
# Conventions used below:
#   VAR=value      — uncommented, must be set or has a real default
#   # VAR=value    — commented, shows the default; uncomment only to override
#   VAR=           — empty, conscious choice required (validator may reject
#                    placeholders in production)


# ═══════════════════════════════════════════════════════════════════════════
# Group 1 — Required for any boot
# ═══════════════════════════════════════════════════════════════════════════

ENV=development
# Values: development | production | test
# Controls log format (JSON in production, plain text otherwise), validator
# strictness (SECRET_KEY length, OPENAI_API_KEY placeholder checks), and
# the is_dev / is_prod / is_testing helper properties.

DATABASE_URL=
# Required. PostgreSQL connection URI. Examples:
#   postgresql://aindy:aindy@postgres:5432/aindy   (Compose-managed default)
#   postgresql://user:pass@localhost:5432/aindy    (local dev)
# Plain postgresql:// uses psycopg3 (the runtime default).
# Use postgresql+psycopg2:// only if explicitly deploying against psycopg2.
# Test environments may set AINDY_ALLOW_SQLITE=1 and use sqlite:// here.

SECRET_KEY=REPLACE_THIS_with_a_32_char_hex_string

AINDY_BOOTSTRAP_ADMIN_EMAIL=
# Optional. If set, the user with this email is granted is_admin=True on every
# boot (grant-only — unsetting the var never revokes admin already granted).
# Bootstrap flow:
#   1. Start the runtime (users table is created).
#   2. Register the admin account: POST /auth/register {email, password}.
#   3. Set this var and restart, OR run:
#        aindy-runtime auth promote-admin <email>
#      (promote-admin works without a restart; no ENV var needed afterward).
# If the email has no matching user at boot time, the runtime logs an INFO
# message and continues normally — no error, no abort.
# Required. Generate with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
# Minimum 32 characters outside test/development. Rotating invalidates all
# active JWTs on next restart.
# The placeholder above is self-rejecting — runtime refuses to boot until
# you replace it (validator catches values starting with REPLACE_THIS).

OPENAI_API_KEY=
# Required for memory embeddings and runtime-default LLM calls.
#   development: empty value logs a warning; OpenAI features unavailable
#                until set, but the runtime still boots.
#   production:  runtime refuses to boot if unset or set to a known
#                placeholder (your-key-here, sk-placeholder, changeme,
#                replace_me).
# Obtain at https://platform.openai.com/api-keys

DEEPSEEK_API_KEY=
# Optional. Only required if workflows route LLM calls to DeepSeek via the
# runtime's built-in LLM client. Leave empty to disable.

# LLM_PROVIDER=openai
# LLM_FALLBACK_PROVIDERS=
# AGENT-HARDEN-5: cross-provider LLM fallback. LLM_PROVIDER is the primary;
# get_llm_client_chain() fails over to each provider in LLM_FALLBACK_PROVIDERS
# (comma-separated, in order) when the primary's circuit breaker is open or its
# call errors. Supported: openai, deepseek. Empty fallback list = single-provider
# behavior (unchanged). Example: LLM_FALLBACK_PROVIDERS=deepseek

AINDY_API_KEY=
# Optional. Bearer token for machine-to-machine calls to this runtime's
# own API surface. Leave empty to disable that auth path.

AINDY_SERVICE_KEY=
# Optional. Secondary service-to-service auth token. Leave empty to
# disable.

ALLOWED_ORIGINS=http://localhost:3000
# Comma-separated CORS origins.
# ⚠ Production deployments MUST replace this. Localhost CORS in production
# allows credential theft from any local-listening process on operator
# machines. Production example:
#   https://app.example.com,https://admin.example.com


# ═══════════════════════════════════════════════════════════════════════════
# Group 2 — Boot mode and deployment profile
# ═══════════════════════════════════════════════════════════════════════════

# Override the .env file location. Default: AINDY/.env relative to the package.
# Set to a stable, version-independent path for containerised deployments so
# the bind-mount target does not need to change across package upgrades.
# Example (docker-compose.yml): AINDY_ENV_FILE=/etc/aindy/.env
#   with volume: ./AINDY/.env:/etc/aindy/.env:ro
# AINDY_ENV_FILE=

# AINDY_BOOT_MODE: runtime-only | full (default: full)
# runtime-only disables the monolith-oriented boot path and starts only the
# runtime stack. Recommended for extracted runtime deployments.
AINDY_BOOT_MODE=runtime-only

# AINDY_DEPLOYMENT_PROFILE:
#   single-instance | distributed-api | distributed-worker | hostile-third-party
# Leave empty to let the runtime derive the profile from EXECUTION_MODE.
# Some profiles enforce AINDY_EVENT_BUS_ENABLED=true (see Group 6).
AINDY_DEPLOYMENT_PROFILE=

# EXECUTION_MODE: thread | distributed
#   Default when UNSET (RTR-2): production (ENV=prod/production) defaults to
#   `distributed`; every other ENV defaults to `thread`. An explicit value here
#   always wins. Rationale: a prod deploy that forgets this now fails fast at
#   queue init (get_queue raises without REDIS_URL) instead of silently running
#   thread-mode jobs that are lost on restart.
#   thread       — ThreadPoolExecutor, single-process only. Correct for
#                  local and low-traffic single-server deployments. Jobs stranded
#                  by a process restart are re-dispatched once at next startup
#                  (RTR-2 thread-mode recovery), but there is no live requeue.
#   distributed  — Redis-backed queue + worker process. Required for any
#                  production deployment. Jobs survive restarts (DLQ + stale
#                  job recovery). Run with `--profile full` to bring Redis
#                  and the worker online alongside the API.
#                  Set this to `distributed` before running --profile full
#                  or the worker is brought up but the API never routes to it.
# EXECUTION_MODE=thread


# ═══════════════════════════════════════════════════════════════════════════
# Group 3 — Schema control
# ═══════════════════════════════════════════════════════════════════════════

# AINDY_ENFORCE_SCHEMA: true | false (default: true in production)
# Validates the schema contract on boot. Disabling enforcement is not
# permitted when ENV=production.
AINDY_ENFORCE_SCHEMA=true

# AINDY_SCHEMA_RECONCILE: true | false (default: false)
# Set to true to run an additive startup reconcile (safe column/index
# additions). Do not set permanently — intended for controlled upgrade
# windows only.
AINDY_SCHEMA_RECONCILE=false

# AINDY_ALLOW_SQLITE: leave empty for production; set to 1 for local
# smoke tests only.
AINDY_ALLOW_SQLITE=


# ═══════════════════════════════════════════════════════════════════════════
# Group 4 — Async job execution
# ═══════════════════════════════════════════════════════════════════════════

# Number of concurrent async job threads (EXECUTION_MODE=thread only).
# For AI workloads (OpenAI/DeepSeek): each job ~10–30 s, recommend >= 8.
# For resource-constrained hosts: reduce to 4.
AINDY_ASYNC_JOB_WORKERS=10

# Max queued jobs before the runtime returns 503.
AINDY_ASYNC_QUEUE_MAXSIZE=100

# Global and per-user concurrency caps (0 = no cap).
# AINDY_ASYNC_MAX_CONCURRENT_GLOBAL=0
# AINDY_ASYNC_MAX_CONCURRENT_PER_USER=0

# Route heavy operations through the async job path even in single-process
# mode. Default: false.
# AINDY_ASYNC_HEAVY_EXECUTION=false

# Enable or disable background task scheduling. Default: true.
# Set to false in environments where only the API surface is needed.
# AINDY_ENABLE_BACKGROUND_TASKS=true

# Background leadership lease (LEASE-1). Only the lease holder runs the
# scheduler maintenance jobs in lease-elected profiles (distributed-api,
# distributed-worker). The leader renews every HEARTBEAT seconds within TTL
# seconds; a follower takes over within one TTL of a leader's death.
# TTL must comfortably exceed HEARTBEAT to tolerate clock skew/GC pauses.
# AINDY_BACKGROUND_LEASE_TTL_SECONDS=60
# AINDY_BACKGROUND_LEASE_HEARTBEAT_SECONDS=20


# ═══════════════════════════════════════════════════════════════════════════
# Group 5 — Flow execution timeouts
# ═══════════════════════════════════════════════════════════════════════════

# Flows can legitimately WAIT for up to FLOW_WAIT_TIMEOUT_MINUTES before
# expiring.
FLOW_WAIT_TIMEOUT_MINUTES=30

# Stuck-run detection: runs older than this (in running/waiting state) are
# recovered.
# MUST be strictly greater than FLOW_WAIT_TIMEOUT_MINUTES.
# Minimum safe value: FLOW_WAIT_TIMEOUT_MINUTES + 15
# (The deprecated alias AINDY_STUCK_RUN_THRESHOLD_MINUTES is no longer read.)
STUCK_RUN_THRESHOLD_MINUTES=45

# How often the watchdog scans for stuck runs (minutes).
AINDY_WATCHDOG_INTERVAL_MINUTES=2


# ═══════════════════════════════════════════════════════════════════════════
# Group 6 — Redis and event bus
# ═══════════════════════════════════════════════════════════════════════════

# Standard Redis URL. Used for cache, event bus, and (when
# EXECUTION_MODE=distributed) the job queue.
# Required when AINDY_CACHE_BACKEND=redis (the default) or when
# EXECUTION_MODE=distributed.
# Examples:
#   redis://redis:6379/0
#   redis://:password@redis:6379/0
# REDIS_URL=

# Redis password for Compose-managed Redis instances. Leave empty if using
# a connection string that already includes auth (redis://:pass@host).
# REDIS_PASSWORD=

# Cache backend. Values: redis | memory | off (default: redis)
#   redis   — production-correct, multi-instance coherent.
#   memory  — FORBIDDEN in production (multi-instance incoherence).
#   off     — disables caching; all reads hit the database. Safe for any
#             deployment but slower.
# AINDY_CACHE_BACKEND=redis

# AINDY_REQUIRE_REDIS: true | false (default: false)
# Controls behavior when Redis is unreachable at startup or runtime:
#   false — degrade gracefully to an in-memory fallback. Job queue and
#           event bus continue functioning at single-process scope. SAFE
#           DEFAULT but operationally surprising: a Redis outage will not
#           crash the runtime, it will silently lose cross-process state.
#   true  — Redis unavailability is fatal. Distributed deployments should
#           set this to true so a Redis outage fails loud rather than
#           degrading invisibly.
# AINDY_REQUIRE_REDIS=false

# AINDY_EVENT_BUS_ENABLED: true | false (default: true)
# Controls whether the cross-process event bus is active.
# Some AINDY_DEPLOYMENT_PROFILE values (distributed-api, distributed-worker)
# enforce this to be true and raise at startup if disabled.
# Set to false ONLY for single-instance no-Redis deployments where
# cross-process event delivery is not needed.
# AINDY_EVENT_BUS_ENABLED=true

# Event bus channel name. Override only if running multiple isolated A.I.N.D.Y.
# instances against the same Redis.
# AINDY_EVENT_BUS_CHANNEL=aindy:scheduler_events


# ═══════════════════════════════════════════════════════════════════════════
# Group 7 — Logging
# ═══════════════════════════════════════════════════════════════════════════

# Root log level: DEBUG | INFO | WARNING | ERROR (default: INFO)
LOG_LEVEL=INFO

# Log format: json | text
# Default: json when ENV=production, text otherwise.
# LOG_FORMAT=


# ═══════════════════════════════════════════════════════════════════════════
# Group 8 — Database connection pool (advanced)
# ═══════════════════════════════════════════════════════════════════════════
# Tune for your host's connection limit (max_connections in postgresql.conf).
# Defaults are conservative and safe for single-instance deployments.

# DB_POOL_SIZE=10
# DB_MAX_OVERFLOW=20
# DB_POOL_TIMEOUT=30
# DB_POOL_RECYCLE=1800
# DB_STATEMENT_TIMEOUT_MS=30000
# DB_IDLE_IN_TRANSACTION_TIMEOUT_MS=30000


# ═══════════════════════════════════════════════════════════════════════════
# Group 9 — MongoDB (optional, social-layer profile)
# ═══════════════════════════════════════════════════════════════════════════
# Required only if the social layer or memory persistence backends use Mongo.
# Leave unset to run without Mongo (MONGO_REQUIRED defaults to false).

# MONGO_URL=mongodb://USER:PASSWORD@HOST:27017/aindy?authSource=admin
# MONGO_DB_NAME=aindy_social_layer
# MONGO_REQUIRED=false
# SKIP_MONGO_PING=false


# ═══════════════════════════════════════════════════════════════════════════
# Group 10 — Server binding
# ═══════════════════════════════════════════════════════════════════════════
# AINDY_HOST=0.0.0.0
# AINDY_PORT=8000


# ═══════════════════════════════════════════════════════════════════════════
# Group 11 — Agent planner
# ═══════════════════════════════════════════════════════════════════════════
# AINDY_AGENT_PLANNER_BACKEND=runtime_local
# AINDY_AGENT_PLANNER_MODEL=gpt-4o
# AINDY_AGENT_PLANNER_TEMPERATURE=0.3
#
# AINDY_AGENT_EXECUTION_BACKEND: agent_flow | nodus_vm (default: agent_flow)
#   agent_flow — static AGENT_FLOW Python DAG (default, fully featured).
#   nodus_vm   — RTR-1 Phase 2c–2e OPT-IN: compile the plan to a native Nodus
#                workflow and run it through the VM (tools via the call_tool
#                seam). Now reproduces per-step retry, halt-on-first-failure, and
#                durable mid-plan WAIT/RESUME. Stays opt-in until real-Postgres
#                parity is validated.
# AINDY_AGENT_EXECUTION_BACKEND=agent_flow
#
# AINDY_AGENT_WAIT_BEFORE_HIGH_RISK: bool (default: false). When true AND
#   AINDY_AGENT_EXECUTION_BACKEND=nodus_vm, the planner inserts a human-approval
#   WAIT step (event "agent.approval.granted") before the first high-risk step, so
#   the run does its safe prep then pauses for approval before the risky action.
#   Release the wait via the app's resume route (POST /agent/runs/{id}/resume →
#   resume_agent_run_runtime → publish_event). Ignored on the agent_flow backend.
# AINDY_AGENT_WAIT_BEFORE_HIGH_RISK=false
#
# AINDY_PLANNER_MEMORY_INJECTION: bool (default: false). INFINITY-RUNTIME-1 Gap 1.
#   When true, generate_plan recalls objective-keyed memory (runtime-owned, via
#   MemoryOrchestrator — not the app planner-context provider) and injects it into
#   the planner prompt so prior execution history informs planning. Off by default
#   so plan quality does not shift silently; opt in after app-side soak. The
#   RECALL_USED observability event fires at recall sites regardless of this flag.
# AINDY_PLANNER_MEMORY_INJECTION=false
#
# AINDY_ASYNC_JOB_LOOP_CLOSURE: bool (default: false). INFINITY-RUNTIME-1 Gap 5.
#   When true, async jobs (sys.v1.job.submit) join the Infinity loop:
#   _execute_job_inline activates the async-execution context so its EXECUTION_*
#   events persist and auto-capture writes a memory node, and each job emits a
#   SCORE_COMPUTED record. Off by default because it makes ALL job workers —
#   including infra jobs (embedding ingestion, metric writing) — write memory +
#   score; opt in after soak. Recall-into-jobs is intentionally not wired.
# AINDY_ASYNC_JOB_LOOP_CLOSURE=false
#
# AINDY_NODUS_MAX_EXECUTION_MS: int ms (default: 30000). Nodus script wall-clock
#   budget, applied to BOTH the worker subprocess timeout AND nodus-lang's internal
#   run_source(timeout_ms=) — one value, so a run can't outlive its budget at either
#   layer. A per-run context override (NodusExecutionContext.max_execution_ms) still
#   wins over this. The default is tight for the app-profile path: the fresh worker
#   subprocess cold-starts the entire plugin stack (~12s) before the script runs, so
#   raise this (e.g. 180000) when running heavy plugin profiles. The durable fix —
#   keeping cold-start out of the budget via a warm worker — is TECH_DEBT
#   NODUS-WARMPOOL-1.
# AINDY_NODUS_MAX_EXECUTION_MS=30000
#
# AINDY_MCP_CLIENT_ENABLED: bool (default: false). ECOGAP-4 / G4b client-side MCP
#   interop. When true, on first tool load the runtime connects to each server in
#   AINDY_MCP_SERVERS, discovers its MCP tools, and registers them as AINDY agent
#   tools named "mcp_<server>_<tool>" (capability "outbound.mcp", risk high). Agents
#   can then call external MCP tools through the normal tool path. Off by default —
#   outbound MCP egress is a deliberate operator choice. Requires the extra:
#   `pip install aindy-runtime[mcp]`. A server unreachable at boot is skipped
#   (logged), never a boot failure.
# AINDY_MCP_CLIENT_ENABLED=false
#
# AINDY_MCP_SERVERS: JSON array of external MCP servers to connect (client mode).
#   Each entry: {"name": str, "url": str (SSE endpoint), "timeout"?: float,
#   "risk"?: "low"|"medium"|"high"}. `name` namespaces the registered tools and must
#   be unique. Example:
#   AINDY_MCP_SERVERS=[{"name":"fs","url":"http://localhost:8080/sse","risk":"high"}]
# AINDY_MCP_SERVERS=
#
# --- MCP SERVER (expose AINDY syscalls as MCP tools; ECOGAP-4 / G4b, server-side) ---
# Used only by `aindy-runtime mcp-server` (a standalone process an MCP client like Claude
# Desktop spawns). Read-only by default; single configured identity.
#
# AINDY_MCP_SERVER_USER_ID: required for the MCP server. Every external MCP call runs as
#   this registered user's id (single configured identity). Get it by registering a user
#   and looking up its id.
# AINDY_MCP_SERVER_USER_ID=
#
# AINDY_MCP_SERVER_ALLOW_WRITES: bool (default false). When false, only read syscalls are
#   exposed (memory.read/search/list/tree/trace). When true, also exposes writes
#   (memory.write, memory.delete, flow.run, event.emit). Exposing writes hands an external
#   LLM side-effecting capability — enable deliberately.
# AINDY_MCP_SERVER_ALLOW_WRITES=false
#
# AINDY_MCP_SERVER_TOOLS: optional comma-separated syscall allowlist that OVERRIDES the
#   read-only/allow-writes defaults entirely. Example:
#   AINDY_MCP_SERVER_TOOLS=sys.v1.memory.read,sys.v1.memory.search
# AINDY_MCP_SERVER_TOOLS=
#
# AINDY_TOOL_IDEMPOTENCY: bool (default false). MEB-0 (Mediated Effect Boundary program,
#   docs/runtime/MEDIATED_EFFECT_BOUNDARY_PROGRAM.md). When true, agent tools registered
#   with execution_guarantee="EXACTLY_ONCE" are deduplicated per (run_id, tool, args) via
#   an EffectRecord write-ahead: a retry replays the cached result instead of re-executing
#   (so a retried "send_email" step does not re-send). Off by default; when off, execute_tool
#   behaves exactly as before. Only tools that declare EXACTLY_ONCE are affected; all others
#   stay AT_LEAST_ONCE regardless.
# AINDY_TOOL_IDEMPOTENCY=false
#
# AINDY_SYSCALL_IDEMPOTENCY: bool (default false). MEB-1b (companion to AINDY_TOOL_IDEMPOTENCY,
#   for the syscall path). When true, syscalls whose SyscallEntry declares
#   execution_guarantee="EXACTLY_ONCE" are deduplicated per (execution_unit_id, syscall,
#   payload) via an EffectRecord write-ahead in the dispatcher gate — a retry replays the
#   cached result instead of re-running the handler. Off by default; when off the gate never
#   fires. Only syscalls that declare EXACTLY_ONCE are affected, and only for UUID-scoped runs
#   (#157 guard). No runtime syscall declares EXACTLY_ONCE yet — this ships the mechanism.
# AINDY_SYSCALL_IDEMPOTENCY=false
#
# AINDY_CAPABILITY_POLICIES: JSON object activating per-capability egress governance (MEB-2a /
#   ECOGAP-4 G4a thin). Registering any policy makes the (dormant) enforce_capability_policy /
#   enforce_capability_rate gates in execute_tool go live — an agent tool call is denied when a
#   recipient/domain target extracted from its args falls outside the allowlist, and rate-limited
#   per the declared rate. Empty/absent = no enforcement (behavior unchanged). Format:
#     {"<capability>": {"recipients": ["@ok.com"], "domains": ["api.ok.com"], "rate": "30/minute"}}
#   NOTE: this level is static arg-string inspection — a tool that builds a URL at runtime is not
#   covered by it. AINDY_EGRESS_ENFORCEMENT (below) adds the runtime-aware socket chokepoint.
#   Example: AINDY_CAPABILITY_POLICIES={"outbound.http":{"domains":["api.example.com"]}}
# AINDY_CAPABILITY_POLICIES=
#
# AINDY_EGRESS_ENFORCEMENT: bool (default false). MEB-2b (ECOGAP-4 G4a strong, in-process form).
#   When true AND the tool's capability carries a `domains` policy (see AINDY_CAPABILITY_POLICIES),
#   execute_tool wraps socket.getaddrinfo for the tool call and denies any hostname resolution
#   outside the allowlist — catching runtime-built URLs the static scan above misses. Off or no
#   domain policy = no effect. Honest limits: IP-literal connects do no getaddrinfo (uncovered);
#   a resolution on a non-context-inheriting thread escapes the scope. The non-bypassable form is
#   the sandbox --network none + mediated proxy. Example:
#   AINDY_EGRESS_ENFORCEMENT=false
# AINDY_EGRESS_ENFORCEMENT=
#
# AINDY_SECRET_SCOPES: JSON object locking secret names to a required capability (MEB-2a), so
#   resolve_secret is fail-closed unless the run holds that capability. Format:
#     {"<secret_name>": "<required_capability>"}
#   The default EnvSecretBroker fetches AINDY_SECRET_<NAME>. Example:
#   AINDY_SECRET_SCOPES={"STRIPE_KEY":"billing.charge"}
# AINDY_SECRET_SCOPES=


# ═══════════════════════════════════════════════════════════════════════════
# Group 12 — Resource quotas (per-ExecutionUnit)
# ═══════════════════════════════════════════════════════════════════════════
# These limits are enforced by ResourceManager for every active execution unit.
# All values are in milliseconds unless noted.
#
# AINDY_QUOTA_CPU_MS — per-run wall-clock cap (default: 300000 = 5 minutes)
#   WARNING: the name is a misnomer. This counts wall-clock elapsed time
#   (monotonic clock), including all network I/O wait. It is NOT CPU time.
#   A single real agent step with memory.recall + embedding API calls takes
#   ~30–40 s of wall-clock time. Size this for your longest expected run.
#   For a 3-step agent where each step calls an LLM (~20 s each), 120 000–
#   300 000 ms is a reasonable range.
#   Accounting fix (exclude I/O wait or rename to wall_time_ms) is tracked
#   as AGENT-RESLIMIT-001 and deferred to post-GA.
# AINDY_QUOTA_CPU_MS=300000
#
# AINDY_QUOTA_MEMORY_BYTES — peak RSS high-water mark (default: 268435456 = 256 MiB)
# AINDY_QUOTA_MEMORY_BYTES=268435456
#
# AINDY_QUOTA_MAX_SYSCALLS — max syscall dispatches per run (default: 100)
# AINDY_QUOTA_MAX_SYSCALLS=100
#
# AINDY_QUOTA_MAX_CONCURRENT — max simultaneous runs per tenant (default: 5)
# AINDY_QUOTA_MAX_CONCURRENT=5


# ═══════════════════════════════════════════════════════════════════════════
# Group 13 — Observability (optional)
# ═══════════════════════════════════════════════════════════════════════════
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317


# ═══════════════════════════════════════════════════════════════════════════
# Group 14 — Watcher subsystem (optional)
# ═══════════════════════════════════════════════════════════════════════════
# The watcher is an optional behavior-monitoring loop, isolated to
# AINDY/watcher/. Safe to leave entirely unset for standard deployments.
#
# AINDY_WATCHER_API_URL=http://localhost:8000
# AINDY_WATCHER_LOG_LEVEL=INFO
# AINDY_WATCHER_POLL_INTERVAL=5.0
# AINDY_WATCHER_FLUSH_INTERVAL=10.0
# AINDY_WATCHER_BATCH_SIZE=20
# AINDY_WATCHER_CONFIRMATION_DELAY=30.0
# AINDY_WATCHER_DISTRACTION_TIMEOUT=60.0
# AINDY_WATCHER_RECOVERY_DELAY=30.0
# AINDY_WATCHER_HEARTBEAT_INTERVAL=300.0
# AINDY_WATCHER_DRY_RUN=false


# ═══════════════════════════════════════════════════════════════════════════
# Group 15 — Distributed worker tuning
# ═══════════════════════════════════════════════════════════════════════════
# All variables below have NO EFFECT unless EXECUTION_MODE=distributed.
#
# AINDY_QUEUE_NAME=aindy:jobs
# WORKER_CONCURRENCY=
# WORKER_HEALTH_PORT=8001
# WORKER_MAX_CONCURRENT_JOBS=
# DLQ_ALERT_THRESHOLD=10
# WORKER_VISIBILITY_TIMEOUT_SECS=
# WORKER_STALE_CHECK_INTERVAL_SECS=
# AINDY_SHUTDOWN_TIMEOUT_SECONDS=30


# ═══════════════════════════════════════════════════════════════════════════
# Group 16 — Legacy surface (optional)
# ═══════════════════════════════════════════════════════════════════════════
# Enables deprecated route prefixes retained for backward compatibility.
# Do not enable in new deployments.
# AINDY_ENABLE_LEGACY_SURFACE=false


# ═══════════════════════════════════════════════════════════════════════════
# Group 17 — Platform UI build-time variables (Vite / platform/src)
# ═══════════════════════════════════════════════════════════════════════════
# These are Vite build-time env vars consumed by platform/src, NOT server
# runtime vars. They must be set before running `npm run build` in platform/.
# They are NOT read from AINDY/.env at server startup.
#
# VITE_API_BASE_URL
#   Base URL for all platform API calls (auth, data, everything).
#   Default: "" (empty string — all API calls are relative to the current
#   origin). This is correct for same-host deployments and local dev
#   (vite.config.ts proxy handles dev server forwarding).
#   Set this only when the API is at a different origin from the SPA:
#     VITE_API_BASE_URL=https://aindy.example.com
#   Pass it as a Docker build arg: --build-arg VITE_API_BASE_URL=...
#   and add ARG/ENV to the Dockerfile platform build stage.
#   (PLATFORM-UI-ENV-1 closed 2026-06-05 — localhost hardcode removed)
# VITE_API_BASE_URL=

# ═══════════════════════════════════════════════════════════════════════════
# Group 18 — Payments (future arc; no implementation yet)
# ═══════════════════════════════════════════════════════════════════════════
# These fields are intentional placeholders for the planned Stripe integration.
# No code reads them yet — see PAYMENTS-ARCHITECTURE-1 in TECH_DEBT.md for
# the three architectural questions that must be answered before implementation
# begins (repo vs. separate service, webhook layer ownership, billing identity).
#
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=


# ═══════════════════════════════════════════════════════════════════════════
# ⚠ Local smoke test only — DO NOT USE IN PRODUCTION ⚠
# ═══════════════════════════════════════════════════════════════════════════
# For zero-infrastructure local testing, replace the Group 1 DATABASE_URL
# above with the following and set AINDY_ALLOW_SQLITE=1 in Group 3:
#
#   DATABASE_URL=sqlite://
#   AINDY_ALLOW_SQLITE=1
#
# SQLite is acceptable only for unit-test-style local smoke checks. It is
# NOT a supported deployment target and several runtime features (advanced
# locking, statement timeouts, JSONB indexes) degrade or fail.
